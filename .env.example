# =============================================================================
# RecoverAI — Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-side (Next.js server component) API base URL. Local/non-Docker
# dev: leave as localhost. docker-compose.yml overrides this to
# http://backend:8000 for the frontend container.
BACKEND_API_URL=http://localhost:8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recoverai
POSTGRES_USER=recoverai
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://recoverai:change-me@localhost:5432/recoverai

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Celery (if used) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- OpenAI (LLM: investigation / explanation / messaging only — NOT financial decisions) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- NVIDIA NIM (Phase 12A-12C — decision EXPLANATION only, never
# financial decisions; see docs/architecture/decision-flow.md "Where the
# LLM participates"). App works with zero LLM availability if unset.
# Default model (Phase 12C): openai/gpt-oss-20b — chosen for reliable,
# ~10-14s structured-JSON responses on live testing; moonshotai/kimi-k3
# (Phase 12B) was measured at 100s+ and swapped out. ---
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=openai/gpt-oss-20b
LLM_REQUEST_TIMEOUT_SECONDS=25

# --- Razorpay ---
# Do not assume an endpoint exists — verify against current official docs before use.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional recovery channels (extensions, not core dependencies) ---
WHATSAPP_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
SARVAM_API_KEY=

# --- Feature flags ---
ENABLE_VOICE_RECOVERY=false
ENABLE_WHATSAPP_RECOVERY=false
ENABLE_LLM_EXPLANATIONS=true

# --- Model / ML ---
MODEL_REGISTRY_PATH=./ml/models/artifacts
DEFAULT_RECOVERY_MODEL_VERSION=v0-baseline

# --- Demo data seed (Phase 6, scripts/seed_demo.py — idempotent) ---
SEED_SEED=42
SEED_N_CASES=1200
SEED_CUSTOMERS_PER_MERCHANT=250
